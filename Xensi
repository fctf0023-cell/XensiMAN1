------------------------------------------------------------
-- UPDATE ESP
------------------------------------------------------------

local function UpdateESP()

    local localCharacter = LP.Character

    local localRoot =
        localCharacter
        and localCharacter:FindFirstChild("HumanoidRootPart")

    for player, data in pairs(ESP) do

        local character = player.Character
        local root =
            character
            and character:FindFirstChild("HumanoidRootPart")

        local humanoid =
            character
            and character:FindFirstChildOfClass("Humanoid")

        if not character or not root or not humanoid then
            DestroyESP(player)
            continue
        end

        local teamHidden =
            Config.TeamCheck
            and LP.Team ~= nil
            and player.Team == LP.Team

        local distance = math.huge

        if localRoot then
            distance =
                (root.Position - localRoot.Position).Magnitude
        end

        local visible =
            Config.ESP
            and not teamHidden
            and distance <= Config.MaxDistance

        data.Billboard.Enabled = visible
        data.Highlight.Enabled =
            visible and Config.Highlight

        data.Box.Visible =
            visible and Config.Box

        ----------------------------------------------------
        -- NAME
        ----------------------------------------------------

        data.Name.Visible = Config.Name
        data.Name.Text = player.DisplayName

        ----------------------------------------------------
        -- HP
        ----------------------------------------------------

        data.HP.Visible = Config.Health

        local health =
            math.max(0, humanoid.Health)

        local maxHealth =
            math.max(1, humanoid.MaxHealth)

        data.HP.Text =
            string.format(
                "HP: %d / %d",
                math.floor(health),
                math.floor(maxHealth)
            )

        ----------------------------------------------------
        -- DISTANCE
        ----------------------------------------------------

        data.Distance.Visible = Config.Distance

        data.Distance.Text =
            string.format(
                "%.0f studs",
                distance
            )

        ----------------------------------------------------
        -- HEALTH BAR
        ----------------------------------------------------

        data.HealthBackground.Visible =
            Config.HealthBar

        data.HealthFill.Size =
            UDim2.new(
                math.clamp(health / maxHealth, 0, 1),
                0,
                1,
                0
            )
    end
end

------------------------------------------------------------
-- PLAYER LIFECYCLE
------------------------------------------------------------

local function SetupPlayer(player)

    if player == LP then
        return
    end

    player.CharacterAdded:Connect(function()
        task.wait(0.25)
        CreateESP(player)
    end)

    player.CharacterRemoving:Connect(function()
        DestroyESP(player)
    end)

    if player.Character then
        task.spawn(CreateESP, player)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    SetupPlayer(player)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(player)
    DestroyESP(player)
end)

------------------------------------------------------------
-- RENDER LOOP
------------------------------------------------------------

RunService.RenderStepped:Connect(function()
    UpdateESP()
end)

------------------------------------------------------------
-- OPEN / CLOSE MENU
------------------------------------------------------------

local menuOpen = false

local function SetMenu(state)

    menuOpen = state

    if state then

        Menu.Visible = true
        Menu.Size = UDim2.fromOffset(270, 0)

        TweenService:Create(
            Menu,
            TweenInfo.new(
                0.22,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),
            {
                Size = Config.MenuSize
            }
        ):Play()

    else

        local tween =
            TweenService:Create(
                Menu,
                TweenInfo.new(
                    0.16,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.In
                ),
                {
                    Size = UDim2.fromOffset(270, 0)
                }
            )

        tween:Play()

        tween.Completed:Once(function()
            if not menuOpen then
                Menu.Visible = false
            end
        end)
    end
end

OpenButton.MouseButton1Click:Connect(function()
    SetMenu(not menuOpen)
end)

