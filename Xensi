local function CreateToggle(label, key, description)

    local Row = Instance.new("TextButton")
    Row.Size = UDim2.new(1, -4, 0, 52)
    Row.BackgroundColor3 = Color3.fromRGB(22, 23, 29)
    Row.Text = ""
    Row.AutoButtonColor = false
    Row.Parent = Scroll

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 9)
    Corner.Parent = Row

    local Label = Instance.new("TextLabel")
    Label.Position = UDim2.fromOffset(13, 6)
    Label.Size = UDim2.new(1, -75, 0, 20)
    Label.BackgroundTransparency = 1
    Label.Text = label
    Label.TextColor3 = Color3.fromRGB(235, 235, 240)
    Label.TextSize = 13
    Label.Font = Enum.Font.GothamBold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Row

    local Desc = Instance.new("TextLabel")
    Desc.Position = UDim2.fromOffset(13, 27)
    Desc.Size = UDim2.new(1, -75, 0, 16)
    Desc.BackgroundTransparency = 1
    Desc.Text = description
    Desc.TextColor3 = Color3.fromRGB(105, 108, 118)
    Desc.TextSize = 9
    Desc.Font = Enum.Font.Gotham
    Desc.TextXAlignment = Enum.TextXAlignment.Left
    Desc.Parent = Row

    local Toggle = Instance.new("Frame")
    Toggle.Size = UDim2.fromOffset(40, 22)
    Toggle.Position = UDim2.new(1, -52, 0.5, -11)
    Toggle.BackgroundColor3 = Color3.fromRGB(55, 57, 65)
    Toggle.Parent = Row

    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(1, 0)
    ToggleCorner.Parent = Toggle

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.fromOffset(18, 18)
    Knob.Position = UDim2.fromOffset(2, 2)
    Knob.BackgroundColor3 = Color3.fromRGB(220, 220, 225)
    Knob.Parent = Toggle

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.CornerRadius = UDim.new(1, 0)
    KnobCorner.Parent = Knob

    local function Refresh()

        local enabled = Config[key]

        TweenService:Create(
            Toggle,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = enabled
                    and Color3.fromRGB(0, 180, 80)
                    or Color3.fromRGB(55, 57, 65)
            }
        ):Play()

        TweenService:Create(
            Knob,
            TweenInfo.new(0.15),
            {
                Position = enabled
                    and UDim2.fromOffset(20, 2)
                    or UDim2.fromOffset(2, 2)
            }
        ):Play()
    end

    Row.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        Refresh()
    end)

    Refresh()

    return Row
end

